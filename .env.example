UNIPILE_BASE_URL=https://api1.unipile.com:13111
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TIMEZONE=America/Los_Angeles
DRY_RUN=false
PAUSED=false
# Your LinkedIn provider_id — agent will never invite or target this profile.
# Find it via Unipile own-profile / relations responses (provider_id field).
# Leave empty to disable self-filtering (not recommended).
OWN_PROVIDER_ID=
# Optional Discord webhook for start/stop, posts, halt, rate-limit alerts.
# Leave empty to disable.
DISCORD_WEBHOOK_URL=
DASHBOARD_PORT=3847
DASHBOARD_HOST=127.0.0.1
