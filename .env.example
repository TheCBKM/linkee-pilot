UNIPILE_BASE_URL=https://api1.unipile.com:13111
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TIMEZONE=America/Los_Angeles
DRY_RUN=false
PAUSED=false
# Your LinkedIn provider_id — agent will never invite or target this profile.
# Find it via Unipile own-profile / relations responses (provider_id field).
# Leave empty to disable self-filtering (not recommended).
OWN_PROVIDER_ID=
# Optional Discord webhook for start/stop, posts, halt, rate-limit alerts.
# Leave empty to disable.
DISCORD_WEBHOOK_URL=
DASHBOARD_PORT=3847
DASHBOARD_HOST=127.0.0.1

# --- Job and freelance search ---
# Remote-only LinkedIn job discovery with AI fit scoring.
ENABLE_JOB_DISCOVERY=true
# Outbound DM drafting and sending to accepted connections.
# Off by default: DMs go out under your name and are the riskiest automation
# here. Nothing is ever sent without your approval, but leave this false until
# you have reviewed a few drafts. See "DM outreach" in the README.
ENABLE_DM=false
# Used in profile audits and DM context. Never auto-inserted as a link.
PORTFOLIO_URL=https://rajaram.info
# Optional resume link, for your own reference in the dashboard.
RESUME_URL=
